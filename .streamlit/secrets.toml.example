# Copy this file to .streamlit/secrets.toml and paste your real key.
# Free key: https://aistudio.google.com/app/apikey
# secrets.toml is git-ignored, so your key stays private.
GEMINI_API_KEY = "paste-your-key-here"

# Optional: force model(s), comma separated, tried in order. If omitted the app tries
# gemini-3.1-flash-lite (largest free daily quota), then gemini-3.5-flash, then gemini-2.5-flash.
# GEMINI_MODEL = "gemini-3.5-flash"
